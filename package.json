{
    "name": "n8n-nodes-n8nchatui",
    "version": "0.1.0",
    "description": "n8n community nodes for n8nChatUI: a webhook trigger and a response node for building n8nChatUI-connected chat workflows without an AI-tool/LangChain dependency.",
    "license": "MIT",
    "homepage": "https://n8nchatui.com",
    "keywords": [
        "n8n-community-node-package",
        "n8nchatui",
        "chat",
        "webhook"
    ],
    "author": {
        "name": "Dani Martin",
        "email": "dani@millsidecreative.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dani-millside-creative/n8n-nodes-n8nchatui.git"
    },
    "bugs": {
        "url": "https://github.com/dani-millside-creative/n8n-nodes-n8nchatui/issues"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist",
        "!dist/tsconfig.tsbuildinfo"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/N8nChatUiApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/N8nChatUiTrigger/N8nChatUiTrigger.node.js",
            "dist/nodes/N8nChatUi/N8nChatUi.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
